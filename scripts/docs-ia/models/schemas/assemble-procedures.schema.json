{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssembleProceduresOutput",
  "type": "object",
  "required": ["procedures"],
  "properties": {
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goal", "actor", "entry", "steps"],
        "properties": {
          "id": { "type": "string" },
          "goal": { "type": "string" },
          "actor": { "type": "string" },
          "entry": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "facts"],
              "properties": {
                "text": { "type": "string" },
                "facts": { "type": "array", "items": { "type": "string" } },
                "platform_seam": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
