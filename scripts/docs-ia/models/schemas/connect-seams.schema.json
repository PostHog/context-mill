{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectSeamsOutput",
  "type": "object",
  "required": ["links"],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "decision", "reason"],
        "properties": {
          "fact_id": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["platform_port", "internal_only", "external", "no_match"]
          },
          "platform_port_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "proof_quote": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
