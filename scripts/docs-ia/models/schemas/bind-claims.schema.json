{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BindClaimsOutput",
  "type": "object",
  "required": ["bindings"],
  "properties": {
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["piece_id", "state", "reason"],
        "properties": {
          "piece_id": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["fresh", "prose-backed", "contradicted", "unverified", "unbound"]
          },
          "fact_codes": { "type": "array", "items": { "type": "string" } },
          "decision_code": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
