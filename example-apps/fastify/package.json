{
  "name": "posthog-fastify-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify burrito API with PostHog Node.js analytics",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "pnpm build && pnpm start"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "posthog-node": "^5.64.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
